# Required for live movie search and metadata (use either option)
TMDB_API_READ_TOKEN=
# TMDB_API_KEY=
DEFAULT_TMDB_MOVIE_ID=986056

# Required for professional review summaries
NYT_API_KEY=

# Required for classification, embeddings, and synthesized Graph RAG answers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for persistence and vector retrieval
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional metadata enrichment
OMDB_API_KEY=

# Strongly recommended on Vercel; enter the same value in the app's Connections dialog
APP_ADMIN_KEY=

# Vercel supplies this as the Authorization bearer token for cron calls
CRON_SECRET=
